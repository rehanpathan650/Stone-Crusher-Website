# Used by docker-compose.yml. Copy to .env and fill in.

# Your domain name pointing at this server (e.g. crusher.example.com). "localhost" for a local trial.
DOMAIN=localhost

# Long random password for the PostgreSQL database
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Optional fixed first-run setup code (otherwise a random one is printed in `docker compose logs app`)
SETUP_TOKEN=

# Optional, for using it only on this computer at http://localhost:APP_PORT:
# COOKIE_SECURE=false
# APP_PORT=4000

# Optional: sign-in attempts allowed per IP address per 15 minutes (default 20)
# LOGIN_RATE_LIMIT=20
