# Copy to server/.env for local runs. Everything is optional.

# development | production
NODE_ENV=development
PORT=4000
# HOST=127.0.0.1          # use 0.0.0.0 to allow other computers on your network

# Database: leave empty for a local SQLite file (server/data/app.db).
# For production / multiple users at scale use PostgreSQL:
# DATABASE_URL=postgres://crusher:password@localhost:5432/crusher
# DATABASE_SSL=false
# DB_POOL_MAX=10

# Cookies are marked Secure (HTTPS only) when NODE_ENV=production. Set false ONLY for plain-HTTP testing.
# COOKIE_SECURE=true
# Set when running behind a reverse proxy (Caddy / Nginx) so client IPs and HTTPS are detected: 1 = one proxy hop
# TRUST_PROXY=1

# Sessions
# SESSION_IDLE_MINUTES=720      # sign out after 12 h of inactivity
# SESSION_MAX_HOURS=168         # always sign out after 7 days

# Brute-force protection
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
# API_RATE_LIMIT_PER_MINUTE=600

# First-run setup code. If empty, a random one is printed in the server log when no users exist.
# SETUP_TOKEN=
